# Managed by Ansible - cAdvisor: CPU, memory and network per container (port 8081)
name: cadvisor

services:
  cadvisor:
    image: "{{ cadvisor_image }}"
    command:
      - --docker_only=true
      - --housekeeping_interval=30s
      - --store_container_labels=false
    ports:
      - "8081:8080"
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
    devices:
      - /dev/kmsg
    privileged: true
    restart: unless-stopped
